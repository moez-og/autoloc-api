        "url": "{{baseUrl}}/api/paiements",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"montant\": 60,\n  \"datePaiement\": \"{{datePaiement}}\",\n  \"modePaiement\": \"CARTE\",\n  \"contratId\": {{contratId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "10 · Consulter les recettes par agence",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code !== 200) {",
              "    pm.execution.setNextRequest(null);",
              "}",
              "if (pm.response.code === 200) {",
              "    pm.test(\"L’agence de démo a encaissé 60 DT\", function () {",
              "        const id = Number(pm.collectionVariables.get(\"agenceId\"));",
              "        const recette = pm.response.json().find(ligne => ligne.agenceId === id);",
              "        pm.expect(recette).to.be.an(\"object\");",
              "        pm.expect(recette.montantEncaisse).to.eql(60);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/metier/statistiques/recettes"
      },
      "response": []
    },
    {
