              "    pm.test(\"Identifiant idContrat retourné\", function () {",
              "        pm.expect(id).to.be.a(\"number\").and.to.be.above(0);",
              "    });",
              "    pm.collectionVariables.set(\"contratId\", id);",
              "    pm.test(\"Le contrat reprend les 204 DT du devis\", function () {",
              "        pm.expect(pm.response.json().montantTotal).to.eql(204);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/metier/reservations/{{reservationId}}/signer",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipementIds\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
