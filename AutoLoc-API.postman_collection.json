              "    });",
              "    pm.collectionVariables.set(\"reservationId\", id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/metier/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": {{clientId}},\n  \"vehiculeId\": {{vehiculeId}},\n  \"dateDebut\": \"{{dateDebut}}\",\n  \"dateFin\": \"{{dateFin}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "08 · Signer le contrat",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code !== 201) {",
